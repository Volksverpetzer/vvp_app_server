# Django app display name, used in push notification messages
APP_NAME=

# Bluesky bot account for posting fact-check replies
BOT_BSKY_HANDLE=
BOT_BSKY_PWD=

# Main Bluesky account for feed fetching
BSKY_HANDLE=
BSKY_PWD=

# PostgreSQL connection string
DATABASE_URL=

# SSL mode for DB connection (e.g. "require", "disable")
DB_SSLMODE=
# Path to SSL root certificate for DB connection
DB_SSLROOTCERT=

# Set to "enabled" to activate Django debug mode
DEBUG=

# Expo push notification server token
EXPO_TOKEN=

# Google Fact Check API key
GOOGLE_FACT=

# Instagram Graph API token for the main (volksverpetzer) account feed
INSTAGRAM_ACCESS_TOKEN=
# Instagram Graph API token for the Prüfpunkt account feed
INSTAGRAM_ACCESS_TOKEN_PRUEFPUNKT=

# Mailgun API credentials for sending report-a-fake emails
MAILGUN_DOMAIN=
MAILGUN_RECEIVER=
MAILGUN_TOKEN=

# Bearer token to authenticate incoming notification webhook calls
NOTIFICATION_BEARER=

# Plausible Analytics API token
PLAUSIBLE_TOKEN=

# Django secret key
SECRET_KEY=

# Stripe live secret key for payment processing
STRIPE_SECRET_KEY=

# TikTok API credentials for feed fetching
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok OAuth refresh token (fallback when no DB token exists)
TIKTOK_REFRESH_TOKEN=

# WordPress site URL for fetching new post webhooks
WP_URL=

# YouTube Data API v3 key for feed fetching
YT_ACCESS_TOKEN=

# Scaleway DB instance for IP allowlist management (scripts/add_ip_to_scaleway_allowlist.sh)
SCALEWAY_API_KEY=
SCALEWAY_INSTANCE_ID=
SCALEWAY_REGION=
